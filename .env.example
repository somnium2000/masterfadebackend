# MasterFade Backend env example

# Server
PORT=3002
HOST=localhost
ENTORNO=development
NODE_ENV=development
LOG_NIVEL=info
TRUST_PROXY=false

# CORS
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Global rate limit
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# Endpoint rate limits
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=1 minute
AUTH_FORGOT_RATE_LIMIT_MAX=10
AUTH_FORGOT_RATE_LIMIT_WINDOW=1 minute
AUTH_EXCHANGE_RATE_LIMIT_MAX=20
AUTH_EXCHANGE_RATE_LIMIT_WINDOW=1 minute
AUTH_SOCIAL_CONFIRM_RATE_LIMIT_MAX=15
AUTH_SOCIAL_CONFIRM_RATE_LIMIT_WINDOW=1 minute
PAGOS_CREAR_INTENT_RATE_LIMIT_MAX=20
PAGOS_CREAR_INTENT_RATE_LIMIT_WINDOW=1 minute
PAGOS_WEBHOOK_RATE_LIMIT_MAX=120
PAGOS_WEBHOOK_RATE_LIMIT_WINDOW=1 minute

# Database
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_TEST_CONNECTION=false
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_POOL_MAX=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_BASE64=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App JWT
JWT_SECRET=
JWT_EXPIRES_IN=12h
APP_JWT_ISSUER=masterfade-api
APP_JWT_AUDIENCE=masterfade-app

# Session cookies + CSRF
COOKIE_SECRET=
CSRF_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_TTL_SECONDS=43200
SERVICE_BARBER_ASSIGNMENTS_ENABLED=false

# Auth recovery
RESET_MAX_ATTEMPTS=3
RESET_WINDOW_MS=900000
RESET_BLOCK_MS=1800000

# URLs
FRONTEND_URL=http://localhost:5173
# URL publica para callbacks/retornos del flujo de pago en /v1/public/pagos/*
# En entornos publicos (qa/staging/prod) debe ser HTTPS real, por ejemplo:
# PUBLIC_WEB_URL=https://masterfadeapp.com
PUBLIC_WEB_URL=
# Alias opcional legacy (si se usa, debe ser HTTPS en entorno publico)
FRONTEND_PUBLIC_URL=
INTERNAL_HEALTH_TOKEN=

# Payments
PAYMENT_PROVIDER=mock
WEBHOOK_REPLAY_WINDOW_SECONDS=300
MOCK_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=

# Mailer
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@masterfade.hn
