# =============================================
# MasterFade — Backend (.env.example)
# Copia este archivo como .env y llena los valores.
# NUNCA subas el .env real al repositorio.
# =============================================

# --- Servidor ---
PORT=3002
HOST=127.0.0.1
ENTORNO=development
# Valores: development | staging | production
LOG_NIVEL=info
# Valores: debug | info | warn | error

# --- CORS (origenes permitidos, separados por coma) ---
# IMPORTANTE: La variable interna usada por el plugin es CORS_ORIGENES (con tilde)
CORS_ORIGENES=http://localhost:5173,http://localhost:5174

# --- Rate Limiting ---
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# =============================================
# CONEXION A BASE DE DATOS (Supabase/PostgreSQL)
# =============================================
# ELIGE UNA OPCIÓN — no uses ambas al mismo tiempo.
#
# OPCION A — Direct Connection (recomendada para desarrollo local):
#   Host: db.<PROJECT_REF>.supabase.co
#   Puerto: 5432
#   Usuario: postgres
#   DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#
# OPCION B — Pooler / pgBouncer (recomendada para produccion):
#   Host: <region>.pooler.supabase.com (ej. aws-0-us-east-1.pooler.supabase.com)
#   Puerto: 6543 (Session Mode) o 5432 (Transaction Mode)
#   Usuario: postgres.<PROJECT_REF>   ← IMPORTANTE: debe incluir el project ref
#   DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<region>.pooler.supabase.com:6543/postgres
#
# ERROR COMUN: "Tenant or user not found" → Usas pooler pero el usuario no incluye .<PROJECT_REF>
#              Solución: cambiar usuario a postgres.<PROJECT_REF> o usar Direct Connection.
DATABASE_URL=

# Alternativa: variables separadas (si no usas DATABASE_URL)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres

# ---- Control de conexion ----
# DB_TEST_CONNECTION=true  → verifica la DB al arrancar (recomendado en produccion)
# DB_TEST_CONNECTION=false → salta el check (para desarrollo sin DB configurada aun)
DB_TEST_CONNECTION=false
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_POOL_MAX=10

# =============================================
# SUPABASE REST / AUTH
# =============================================
SUPABASE_URL=
# URL del proyecto: https://<PROJECT_REF>.supabase.co

SUPABASE_ANON_KEY=
# Clave publica (anon) — visible en: Supabase Dashboard → Settings → API → anon/public

SUPABASE_SERVICE_ROLE_KEY=
# Clave de servicio — SECRETO, solo en backend. Nunca en frontend.
# Visible en: Supabase Dashboard → Settings → API → service_role

# =============================================
# JWT PROPIO DE LA APLICACION
# =============================================
# Genera un secreto: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
APP_JWT_ISSUER=masterfade-api
APP_JWT_AUDIENCE=masterfade-app

# Reset de contraseña (rate limiting en memoria — mover a BD en produccion)
RESET_MAX_ATTEMPTS=3
RESET_WINDOW_MS=900000
RESET_BLOCK_MS=1800000

# URL del frontend (para redirect en reset de contraseña)
FRONTEND_URL=http://localhost:5173

# Auth exchange social (Google): sucursal por defecto opcional para alta interna mínima.
# Si no se define, se usa la primera sucursal activa encontrada.
# AUTH_EXCHANGE_DEFAULT_BRANCH_ID=

# =============================================
# PASARELA DE PAGOS
# =============================================
# Proveedor activo: mock (desarrollo) | banpais (produccion)
PAYMENT_PROVIDER=mock

# BANPAIS (completar cuando se tenga documentacion del proveedor)
# BANPAIS_API_KEY=
# BANPAIS_API_URL=
# BANPAIS_WEBHOOK_SECRET=
# BANPAIS_CALLBACK_URL=http://localhost:3002/v1/pagos/webhook/banpais

# =============================================
# NOTIFICACIONES EMAIL
# =============================================
# Opcion 2 (implementada): el backend genera links con Supabase Admin
# y envia el correo via SMTP para evitar limites de envio de Supabase.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@masterfade.hn
# SMTP_SECURE=false
# SMTP_VERIFY_ON_BOOT=false

# =============================================
# CONFIGURACION DE NEGOCIO
# =============================================
# ISV (actualmente 0% — activar cuando corresponda)
ISV_ACTIVO=false
ISV_PORCENTAJE=0

# Ventana de HOLD para reservas (minutos)
HOLD_MINUTES=5

# Minutos de tolerancia antes de marcar NO_SHOW automaticamente
NOSHOW_TOLERANCE_MINUTES=10
