# MasterFade Backend staging/preproduction env example
# No usar secretos reales en este archivo. Copiar a .env del entorno y completar placeholders.

# Server
NODE_ENV=staging
ENTORNO=staging
HOST=0.0.0.0
PORT=3002
LOG_NIVEL=info
TRUST_PROXY=true

# HTTPS frontend + CORS
FRONTEND_URL=https://masterfadeapp.com
CORS_ORIGENES=https://masterfadeapp.com

# Session cookies + CSRF
COOKIE_SECRET=<COOKIE_SECRET_MIN_24_CHARS>
CSRF_SECRET=<CSRF_SECRET_MIN_24_CHARS>
# Debe ser un secreto estable y exclusivo del entorno, minimo 32 caracteres.
BOOKING_RELEASE_TOKEN_SECRET=<BOOKING_RELEASE_TOKEN_SECRET_MIN_32_CHARS>
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_TTL_SECONDS=43200

# Supabase Auth/Admin
SUPABASE_URL=https://pdzsmkjnyazpkoocjbpw.supabase.co
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# Database - Supabase Pooler session mode.
# Alternativa: usar DATABASE_URL con el mismo host pooler, puerto 5432 y sslmode=require.
DATABASE_URL=
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.pdzsmkjnyazpkoocjbpw
DB_PASSWORD=<DB_PASSWORD>
DB_NAME=postgres
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_TEST_CONNECTION=true
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_BASE64=

# App JWT
JWT_SECRET=<JWT_SECRET_MIN_24_CHARS>
JWT_EXPIRES_IN=12h
APP_JWT_ISSUER=masterfade-api
APP_JWT_AUDIENCE=masterfade-app

# Global rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Endpoint rate limits
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=1 minute
AUTH_FORGOT_RATE_LIMIT_MAX=10
AUTH_FORGOT_RATE_LIMIT_WINDOW=1 minute
AUTH_EXCHANGE_RATE_LIMIT_MAX=20
AUTH_EXCHANGE_RATE_LIMIT_WINDOW=1 minute
AUTH_SOCIAL_CONFIRM_RATE_LIMIT_MAX=15
AUTH_SOCIAL_CONFIRM_RATE_LIMIT_WINDOW=1 minute
PAGOS_CREAR_INTENT_RATE_LIMIT_MAX=20
PAGOS_CREAR_INTENT_RATE_LIMIT_WINDOW=1 minute
PAGOS_WEBHOOK_RATE_LIMIT_MAX=120
PAGOS_WEBHOOK_RATE_LIMIT_WINDOW=1 minute

# Auth recovery
RESET_MAX_ATTEMPTS=3
RESET_WINDOW_MS=900000
RESET_BLOCK_MS=1800000

# Payments
PAYMENT_PROVIDER=todopago
TODOPAGO_MODE=preprod_real
TODOPAGO_SIMULATED_ENABLED=false
TODOPAGO_BASE_URL=https://test-api.todopago.hn
TODOPAGO_USERNAME=<TODOPAGO_USERNAME>
TODOPAGO_PASSWORD=<TODOPAGO_PASSWORD>
TODOPAGO_COMMERCE_ID=<TODOPAGO_COMMERCE_ID>
TODOPAGO_TENANT=<TODOPAGO_TENANT>
TODOPAGO_TERMINAL=<TODOPAGO_TERMINAL>
WEBHOOK_REPLAY_WINDOW_SECONDS=300
MOCK_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=

# Feature flags
MASTERPUNTOS_ENABLED=true
SERVICE_BARBER_ASSIGNMENTS_ENABLED=false

# Healthcheck interno
INTERNAL_HEALTH_TOKEN=<INTERNAL_HEALTH_TOKEN>

# Mailer pausado en esta microfase.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@masterfadeapp.com
