NODE_ENV=staging
PORT=3000

# Base de Datos (Staging)
# Se recomienda usar una base de datos de prueba separada de produccion
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=masterfade_staging
DB_PASSWORD=staging_password_seguro
DB_NAME=masterfade_staging

# Frontend URL
# Debe ser HTTPS en staging para probar correctamente CORS y cookies seguras
FRONTEND_URL=https://staging.tu-dominio.com

# Pagos
# En staging no se debe usar preprod_simulated.
PAYMENT_PROVIDER=todopago
TODOPAGO_MODE=preprod_real
TODOPAGO_SIMULATED_ENABLED=false
TODOPAGO_BASE_URL=https://test-api.todopago.hn
TODOPAGO_USERNAME=
TODOPAGO_PASSWORD=
TODOPAGO_COMMERCE_ID=
TODOPAGO_TENANT=
TODOPAGO_TERMINAL=

# Autenticacion
# Clave JWT para staging (distinta a dev y prod)
JWT_SECRET=super_secret_staging_key_change_me
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
# Parametros de proteccion para staging
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# MasterPuntos
# Puede estar habilitado para pruebas
MASTERPUNTOS_ENABLED=true
SERVICE_BARBER_ASSIGNMENTS_ENABLED=false
