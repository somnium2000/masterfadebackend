NODE_ENV=staging
PORT=3000

# Base de Datos (Staging)
# Se recomienda usar una base de datos de prueba separada de produccion
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=masterfade_staging
DB_PASSWORD=staging_password_seguro
DB_NAME=masterfade_staging

# Frontend URL
# Debe ser HTTPS en staging para probar correctamente CORS y cookies seguras
FRONTEND_URL=https://staging.tu-dominio.com

# Autenticacion
# Clave JWT para staging (distinta a dev y prod)
JWT_SECRET=super_secret_staging_key_change_me
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
# Parametros de proteccion para staging
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# MasterPuntos
# Puede estar habilitado para pruebas
MASTERPUNTOS_ENABLED=true
