  "views": [
    {
      "acl": [
        "postgres=arwdDxtm/postgres",
        "mf_audit_readonly=r/postgres"
      ],
      "name": "vw_points_balance",
      "options": null,
      "definition": " WITH ledger_balance AS (\n         SELECT pt.id_cliente,\n            COALESCE(sum(pt.puntos), 0::bigint) AS ledger_points\n           FROM points_transactions pt\n          GROUP BY pt.id_cliente\n        ), pending_expired_cycles AS (\n         SELECT pc.id_cliente,\n            pc.id_cycle,\n            COALESCE(sum(pt.puntos), 0::bigint) AS remaining_points\n           FROM points_cycles pc\n             JOIN points_transactions pt ON pt.id_cycle = pc.id_cycle\n          WHERE pc.estado_ciclo_codigo = 'activo'::text AND pc.vence_at IS NOT NULL AND pc.vence_at <= now()\n          GROUP BY pc.id_cliente, pc.id_cycle\n        ), pending_expiration_by_client AS (\n         SELECT pec.id_cliente,\n            COALESCE(sum(\n                CASE\n                    WHEN pec.remaining_points > 0 THEN pec.remaining_points\n                    ELSE 0::bigint\n                END), 0::bigint::numeric) AS pending_expired_points\n           FROM pending_expired_cycles pec\n          GROUP BY pec.id_cliente\n        )\n SELECT lb.id_cliente,\n    (lb.ledger_points::numeric - COALESCE(pe.pending_expired_points, 0::bigint::numeric))::integer AS balance_puntos\n   FROM ledger_balance lb\n     LEFT JOIN pending_expiration_by_client pe ON pe.id_cliente = lb.id_cliente;"
    },
    {
      "acl": [
        "postgres=arwdDxtm/postgres",
        "mf_audit_readonly=r/postgres"
      ],
      "name": "vw_points_redemption_services",
      "options": null,
      "definition": " SELECT prs.id_rule_service,\n    pr.id_rule,\n    pr.id_sucursal,\n    prs.cliente_condicion_codigo,\n    prs.id_servicio,\n    s.nombre_servicio,\n    s.descripcion AS descripcion_servicio,\n    s.grupo_catalogo,\n    COALESCE(prs.puntos_canje, pr.puntos_para_premio) AS puntos_requeridos,\n    prs.puntos_canje AS puntos_canje_override,\n    pr.puntos_para_premio AS puntos_para_premio_regla,\n    prs.habilitado AS regla_servicio_activa,\n    prs.visible_cliente,\n    prs.orden_visual,\n    pr.activo AS regla_puntos_activa,\n    s.activo AS servicio_activo,\n    s.visible_publico AS servicio_visible_publico,\n    s.agendable AS servicio_agendable,\n    prs.created_at,\n    prs.updated_at\n   FROM points_rule_services prs\n     JOIN points_rules pr ON pr.id_rule = prs.id_rule\n     JOIN servicios s ON s.id_servicio = prs.id_servicio\n  WHERE s.deleted_at IS NULL;"
    }
  ],
  "counts": {
